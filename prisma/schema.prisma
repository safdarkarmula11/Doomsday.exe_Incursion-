generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One brand kit per event (or one shared default). Logos keep their real
// width/height so the renderer can preserve the aspect ratio.
model BrandKit {
  id         String    @id @default(cuid())
  name       String
  logos      Json // { acm: { url, width, height }, svnit: { url, width, height } }
  colors     Json // { primary, secondary, text }
  fonts      Json // { heading, body }
  roleColors Json // { participant: { bg, accent }, organizer: {...}, ... }
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  projects   Project[]
}

model Project {
  id         String    @id @default(cuid())
  name       String
  designType String    @default("id_card")
  eventData  Json      @default("{}") // eventName, tagline, date, venue, roles, fieldsToShow, qrBaseUrl
  status     String    @default("describe") // describe | questions | drafts | editor | export
  brandKitId String?
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  people     Person[]
  drafts     Draft[]
  assets     Asset[]
}

// One row per card.
model Person {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  role       String
  externalId String?
  photoUrl   String?
  extra      Json    @default("{}")

  @@index([projectId])
}

// Template JSON is stored here so new designs need no code change.
model Template {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  designType String   @default("id_card")
  json       Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  drafts     Draft[]
}

// config = editor state on top of the template. Older versions act as history.
model Draft {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  config     Json     @default("{}")
  selected   Boolean  @default(false)
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Asset {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  kind      String // logo | photo | csv
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([projectId])
}

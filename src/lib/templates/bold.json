    {
    "id": "bold",
    "name": "Bold",
    "version": 1,
    "canvas": {
        "width": 540,
        "height": 856,
        "background": "#ffffff"
    },
    "roleColors": {
        "participant": "#2563eb",
        "organizer": "#dc2626",
        "mentor": "#7c3aed",
        "volunteer": "#059669"
    },
    "layers": [
        {
        "id": "logo-left",
        "type": "image",
        "x": 30,
        "y": 24,
        "w": 200,
        "h": 62,
        "src": "{{logoLeft}}",
        "fit": "contain",
        "align": "left"
        },
        {
        "id": "logo-right",
        "type": "image",
        "x": 310,
        "y": 24,
        "w": 200,
        "h": 62,
        "src": "{{logoRight}}",
        "fit": "contain",
        "align": "right"
        },
        {
        "id": "role-block",
        "type": "rect",
        "x": 0,
        "y": 110,
        "w": 540,
        "h": 360,
        "fill": "$role"
        },
        {
        "id": "event-name",
        "type": "text",
        "x": 30,
        "y": 128,
        "w": 480,
        "h": 66,
        "text": "{{eventName}}",
        "font": "Arial, sans-serif",
        "size": 54,
        "minSize": 28,
        "weight": 700,
        "color": "#ffffff",
        "align": "left",
        "uppercase": true
        },
        {
        "id": "event-subtitle",
        "type": "text",
        "x": 30,
        "y": 196,
        "w": 480,
        "h": 34,
        "text": "{{eventSubtitle}}",
        "font": "Arial, sans-serif",
        "size": 24,
        "minSize": 14,
        "weight": 600,
        "color": "#ffffff",
        "align": "left",
        "uppercase": true,
        "optional": true
        },
        {
        "id": "photo-frame",
        "type": "rect",
        "x": 24,
        "y": 256,
        "w": 218,
        "h": 280,
        "fill": "#ffffff",
        "radius": 6
        },
        {
        "id": "photo",
        "type": "image",
        "x": 30,
        "y": 262,
        "w": 206,
        "h": 268,
        "src": "{{photo}}",
        "fit": "cover",
        "shape": "rect",
        "fallback": "initials"
        },
        {
        "id": "name",
        "type": "text",
        "x": 262,
        "y": 262,
        "w": 248,
        "h": 190,
        "text": "{{name}}",
        "font": "Arial, sans-serif",
        "size": 40,
        "minSize": 22,
        "weight": 700,
        "color": "#ffffff",
        "align": "left",
        "uppercase": true,
        "maxLines": 4,
        "lineHeight": 1.05
        },
        {
        "id": "event-date",
        "type": "text",
        "x": 262,
        "y": 490,
        "w": 248,
        "h": 32,
        "text": "{{eventDate}}",
        "font": "Arial, sans-serif",
        "size": 26,
        "minSize": 14,
        "weight": 700,
        "color": "#111827",
        "align": "left",
        "uppercase": true,
        "optional": true
        },
        {
        "id": "venue",
        "type": "text",
        "x": 262,
        "y": 526,
        "w": 248,
        "h": 26,
        "text": "{{venue}}",
        "font": "Arial, sans-serif",
        "size": 20,
        "minSize": 12,
        "weight": 400,
        "color": "#4b5563",
        "align": "left",
        "optional": true
        },
        {
        "id": "id-number",
        "type": "text",
        "x": 30,
        "y": 570,
        "w": 480,
        "h": 56,
        "text": "ID: {{idNumber}}",
        "font": "Arial, sans-serif",
        "size": 46,
        "minSize": 24,
        "weight": 700,
        "color": "#111827",
        "align": "left"
        },
        {
        "id": "divider",
        "type": "rect",
        "x": 30,
        "y": 646,
        "w": 480,
        "h": 8,
        "fill": "$role"
        },
        {
        "id": "bottom-band",
        "type": "rect",
        "x": 0,
        "y": 716,
        "w": 540,
        "h": 140,
        "fill": "$role"
        },
        {
        "id": "role-badge",
        "type": "badge",
        "x": 70,
        "y": 752,
        "w": 400,
        "h": 72,
        "text": "{{role}}",
        "fill": "#ffffff",
        "color": "$role",
        "size": 34,
        "radius": 10
        }
    ]
    }
{
  "id": "geometric",
  "name": "Geometric",
  "version": 1,
  "canvas": {
    "width": 540,
    "height": 856,
    "background": "#f1f5f9"
  },
  "roleColors": {
    "participant": "#2563eb",
    "organizer": "#dc2626",
    "mentor": "#7c3aed",
    "volunteer": "#059669"
  },
  "layers": [
    {
      "id": "tl-1",
      "type": "polygon",
      "x": -10,
      "y": -10,
      "w": 170,
      "h": 170,
      "points": [
        [
          0,
          0
        ],
        [
          100,
          0
        ],
        [
          0,
          100
        ]
      ],
      "fill": "$role"
    },
    {
      "id": "tl-2",
      "type": "polygon",
      "x": -10,
      "y": -10,
      "w": 120,
      "h": 120,
      "points": [
        [
          0,
          0
        ],
        [
          100,
          0
        ],
        [
          0,
          100
        ]
      ],
      "fill": "#0f172a",
      "opacity": 0.85
    },
    {
      "id": "br-1",
      "type": "polygon",
      "x": 380,
      "y": 696,
      "w": 170,
      "h": 170,
      "points": [
        [
          100,
          0
        ],
        [
          100,
          100
        ],
        [
          0,
          100
        ]
      ],
      "fill": "$role"
    },
    {
      "id": "br-2",
      "type": "polygon",
      "x": 430,
      "y": 746,
      "w": 120,
      "h": 120,
      "points": [
        [
          100,
          0
        ],
        [
          100,
          100
        ],
        [
          0,
          100
        ]
      ],
      "fill": "#0f172a",
      "opacity": 0.85
    },
    {
      "id": "logo-left",
      "type": "image",
      "x": 150,
      "y": 30,
      "w": 110,
      "h": 56,
      "src": "{{logoLeft}}",
      "fit": "contain",
      "align": "right"
    },
    {
      "id": "logo-right",
      "type": "image",
      "x": 280,
      "y": 30,
      "w": 110,
      "h": 56,
      "src": "{{logoRight}}",
      "fit": "contain",
      "align": "left"
    },
    {
      "id": "event-name",
      "type": "text",
      "x": 30,
      "y": 108,
      "w": 480,
      "h": 40,
      "text": "{{eventName}}",
      "font": "Arial, sans-serif",
      "size": 28,
      "minSize": 14,
      "weight": 700,
      "color": "#0f172a",
      "align": "center",
      "uppercase": true
    },
    {
      "id": "photo",
      "type": "image",
      "x": 150,
      "y": 168,
      "w": 240,
      "h": 240,
      "src": "{{photo}}",
      "fit": "cover",
      "shape": "circle",
      "fallback": "initials",
      "ringColor": "$role",
      "ringWidth": 8
    },
    {
      "id": "name",
      "type": "text",
      "x": 30,
      "y": 448,
      "w": 480,
      "h": 90,
      "text": "{{name}}",
      "font": "Arial, sans-serif",
      "size": 40,
      "minSize": 20,
      "weight": 700,
      "color": "#0f172a",
      "align": "center",
      "uppercase": true,
      "maxLines": 2,
      "lineHeight": 1.1
    },
    {
      "id": "name-underline",
      "type": "rect",
      "x": 220,
      "y": 552,
      "w": 100,
      "h": 6,
      "fill": "$role",
      "radius": 3
    },
    {
      "id": "role-badge",
      "type": "badge",
      "x": 145,
      "y": 580,
      "w": 250,
      "h": 46,
      "text": "{{role}}",
      "fill": "$role",
      "color": "#ffffff",
      "size": 20
    },
    {
      "id": "id-number",
      "type": "text",
      "x": 30,
      "y": 646,
      "w": 480,
      "h": 28,
      "text": "ID: {{idNumber}}",
      "font": "Arial, sans-serif",
      "size": 22,
      "minSize": 12,
      "weight": 700,
      "color": "#334155",
      "align": "center"
    },
    {
      "id": "event-date",
      "type": "text",
      "x": 30,
      "y": 684,
      "w": 480,
      "h": 26,
      "text": "{{eventDate}}",
      "font": "Arial, sans-serif",
      "size": 18,
      "minSize": 12,
      "weight": 600,
      "color": "#64748b",
      "align": "center",
      "uppercase": true,
      "optional": true
    },
    {
      "id": "qr",
      "type": "qr",
      "x": 215,
      "y": 716,
      "w": 110,
      "h": 110,
      "value": "{{qrUrl}}"
    }
  ]
}
{
  "id": "midnight",
  "name": "Midnight",
  "version": 1,
  "canvas": {
    "width": 540,
    "height": 856,
    "background": "#0f172a"
  },
  "roleColors": {
    "participant": "#3b82f6",
    "organizer": "#ef4444",
    "mentor": "#a855f7",
    "volunteer": "#10b981"
  },
  "layers": [
    {
      "id": "glow",
      "type": "ellipse",
      "x": 290,
      "y": 480,
      "w": 420,
      "h": 420,
      "fill": "$role",
      "opacity": 0.18
    },
    {
      "id": "glow2",
      "type": "ellipse",
      "x": -150,
      "y": -120,
      "w": 360,
      "h": 360,
      "fill": "$role",
      "opacity": 0.12
    },
    {
      "id": "logo-plate",
      "type": "rect",
      "x": 0,
      "y": 0,
      "w": 540,
      "h": 120,
      "fill": "#ffffff"
    },
    {
      "id": "logo-left",
      "type": "image",
      "x": 30,
      "y": 30,
      "w": 200,
      "h": 64,
      "src": "{{logoLeft}}",
      "fit": "contain",
      "align": "left"
    },
    {
      "id": "logo-right",
      "type": "image",
      "x": 310,
      "y": 30,
      "w": 200,
      "h": 64,
      "src": "{{logoRight}}",
      "fit": "contain",
      "align": "right"
    },
    {
      "id": "event-name",
      "type": "text",
      "x": 30,
      "y": 138,
      "w": 480,
      "h": 40,
      "text": "{{eventName}}",
      "font": "Arial, sans-serif",
      "size": 32,
      "minSize": 16,
      "weight": 700,
      "color": "#ffffff",
      "align": "center",
      "uppercase": true
    },
    {
      "id": "event-subtitle",
      "type": "text",
      "x": 30,
      "y": 182,
      "w": 480,
      "h": 28,
      "text": "{{eventSubtitle}}",
      "font": "Arial, sans-serif",
      "size": 20,
      "minSize": 12,
      "weight": 700,
      "color": "$role",
      "align": "center",
      "uppercase": true,
      "optional": true
    },
    {
      "id": "photo",
      "type": "image",
      "x": 150,
      "y": 236,
      "w": 240,
      "h": 240,
      "src": "{{photo}}",
      "fit": "cover",
      "shape": "circle",
      "fallback": "initials",
      "ringColor": "$role",
      "ringWidth": 8
    },
    {
      "id": "name",
      "type": "text",
      "x": 30,
      "y": 512,
      "w": 480,
      "h": 90,
      "text": "{{name}}",
      "font": "Arial, sans-serif",
      "size": 40,
      "minSize": 20,
      "weight": 700,
      "color": "#ffffff",
      "align": "center",
      "uppercase": true,
      "maxLines": 2,
      "lineHeight": 1.1
    },
    {
      "id": "role-badge",
      "type": "badge",
      "x": 145,
      "y": 616,
      "w": 250,
      "h": 48,
      "text": "{{role}}",
      "fill": "$role",
      "color": "#ffffff",
      "size": 22
    },
    {
      "id": "id-number",
      "type": "text",
      "x": 30,
      "y": 716,
      "w": 360,
      "h": 30,
      "text": "ID: {{idNumber}}",
      "font": "Arial, sans-serif",
      "size": 24,
      "minSize": 12,
      "weight": 700,
      "color": "#e2e8f0",
      "align": "left"
    },
    {
      "id": "event-date",
      "type": "text",
      "x": 30,
      "y": 760,
      "w": 360,
      "h": 28,
      "text": "{{eventDate}}",
      "font": "Arial, sans-serif",
      "size": 20,
      "minSize": 12,
      "weight": 600,
      "color": "#94a3b8",
      "align": "left",
      "uppercase": true,
      "optional": true
    },
    {
      "id": "qr",
      "type": "qr",
      "x": 408,
      "y": 704,
      "w": 100,
      "h": 100,
      "value": "{{qrUrl}}"
    },
    {
      "id": "footer-band",
      "type": "rect",
      "x": 0,
      "y": 816,
      "w": 540,
      "h": 40,
      "fill": "$role"
    }
  ]
}